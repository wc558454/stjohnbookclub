
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a member of the St. John Chrysostom Bookclub, including their personal details, progress metrics, and administrative attributes.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "profilePictureUrl": { "type": "string", "format": "uri" },
        "batchYear": { "type": "string" },
        "readingLevel": { "type": "string" },
        "points": { "type": "number", "format": "int32" },
        "currentPagesRead": { "type": "number" },
        "level": { "type": "number", "format": "int32" },
        "streak": { "type": "number", "format": "int32" },
        "status": { "type": "string" },
        "role": { "type": "string" },
        "pagesPerDay": { "type": "number" },
        "lastReadAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "batchYear", "readingLevel", "points", "level", "streak", "status", "role"]
    },
    "Book": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Book",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "totalPages": { "type": "number" },
        "status": {
          "type": "string",
          "description": "The current status of the book in the reading cycle.",
          "enum": ["current", "finished", "pending", "archived"]
        },
        "currentReadingPlanDueDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "description", "totalPages", "status"]
    },
    "Challenge": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Challenge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "pointsReward": { "type": "number" },
        "completionCriteria": { "type": "string" },
        "type": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "title", "pointsReward", "type", "isActive"]
    },
    "UserChallenge": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserChallenge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "challengeId": { "type": "string" },
        "status": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" },
        "pointsEarned": { "type": "number" }
      },
      "required": ["id", "userId", "challengeId", "status"]
    },
    "Discussion": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Discussion",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "topic": { "type": "string" },
        "scheduledDateTime": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "topic", "scheduledDateTime", "isActive"]
    },
    "Notification": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "message": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "message", "isRead", "createdAt", "expiresAt"]
    },
    "ForumPost": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ForumPost",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "content": { "type": "string" },
        "likes": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorId", "authorName", "content", "createdAt"]
    },
    "Comment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Comment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "postId", "authorId", "authorName", "content", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "User profiles."
        }
      },
      {
        "path": "/users/{userId}/notifications/{notifId}",
        "definition": {
          "entityName": "Notification",
          "schema": { "$ref": "#/backend/entities/Notification" },
          "description": "User notifications."
        }
      },
      {
        "path": "/challenges/{challengeId}",
        "definition": {
          "entityName": "Challenge",
          "schema": { "$ref": "#/backend/entities/Challenge" },
          "description": "Global challenges."
        }
      },
      {
        "path": "/discussions/{discussionId}",
        "definition": {
          "entityName": "Discussion",
          "schema": { "$ref": "#/backend/entities/Discussion" },
          "description": "Scheduled discussions."
        }
      },
      {
        "path": "/books/{bookId}",
        "definition": {
          "entityName": "Book",
          "schema": { "$ref": "#/backend/entities/Book" },
          "description": "Library books."
        }
      },
      {
        "path": "/forumPosts/{postId}",
        "definition": {
          "entityName": "ForumPost",
          "schema": { "$ref": "#/backend/entities/ForumPost" },
          "description": "Forum posts."
        }
      },
      {
        "path": "/forumPosts/{postId}/comments/{commentId}",
        "definition": {
          "entityName": "Comment",
          "schema": { "$ref": "#/backend/entities/Comment" },
          "description": "Comments on forum posts."
        }
      }
    ]
  }
}
