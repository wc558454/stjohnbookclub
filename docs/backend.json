
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a member of the St. John Chrysostom Bookclub, including their personal details, progress metrics, and administrative attributes.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "name": {
          "type": "string",
          "description": "The full name of the user."
        },
        "email": {
          "type": "string",
          "description": "The user's email address, used for contact and display purposes. (Not for authentication credentials)",
          "format": "email"
        },
        "profilePictureUrl": {
          "type": "string",
          "description": "URL to the user's uploaded profile picture.",
          "format": "uri"
        },
        "batchYear": {
          "type": "string",
          "description": "The year or batch identifier when the user joined the bookclub."
        },
        "guidingSaint": {
          "type": "string",
          "description": "The name of the saint chosen by the user to guide them on their journey."
        },
        "points": {
          "type": "number",
          "description": "The total cumulative points earned by the user.",
          "format": "int32"
        },
        "level": {
          "type": "number",
          "description": "The current achievement level of the user based on points or engagement.",
          "format": "int32"
        },
        "streak": {
          "type": "number",
          "description": "The current consecutive daily activity streak of the user.",
          "format": "int32"
        },
        "longestStreak": {
          "type": "number",
          "description": "The highest consecutive daily activity streak ever achieved by the user.",
          "format": "int32"
        },
        "status": {
          "type": "string",
          "description": "The active status of the user (e.g., 'Active', 'Inactive')."
        },
        "role": {
          "type": "string",
          "description": "The role of the user within the bookclub (e.g., 'member', 'admin')."
        },
        "spiritualGoal": {
          "type": "string",
          "description": "A short, personal spiritual goal set by the user during registration.",
          "maxLength": 500
        },
        "monthlyPoints": {
          "type": "number",
          "description": "The total points earned by the user in the current month.",
          "format": "int32"
        },
        "currentMonth": {
          "type": "string",
          "description": "The current month for which monthly points are being tracked, in YYYY-MM format."
        },
        "weeklyPoints": {
          "type": "number",
          "description": "The total points earned by the user in the current week.",
          "format": "int32"
        },
        "currentWeek": {
          "type": "string",
          "description": "The identifier for the current week, usually the date of the most recent Monday in YYYY-MM-DD format."
        },
        "personalBestPages": {
          "type": "number",
          "description": "The highest number of pages read by the user in a single day.",
          "format": "int32"
        },
        "dailyPagesRead": {
          "type": "number",
          "description": "Total pages read by the user today. Resets on first activity of a new day.",
          "format": "int32"
        },
        "currentPagesRead": {
          "type": "number",
          "description": "Pages read in the current active book."
        },
        "currentBookId": {
          "type": "string",
          "description": "The ID of the book the user has currently selected for study."
        },
        "bookProgress": {
          "type": "object",
          "description": "A record of progress (pages read) for each book ID the user has engaged with."
        },
        "freezeCount": {
          "type": "number",
          "description": "Remaining streak freezes for the current week."
        },
        "groupName": {
          "type": "string",
          "description": "The name of the small group or cohort the user belongs to."
        },
        "pagesPerWeek": {
          "type": "number",
          "description": "The user's planned reading goal in pages per week."
        },
        "badges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "iconName": { "type": "string" },
              "awardedAt": { "type": "string", "format": "date-time" },
              "message": { "type": "string" }
            }
          }
        },
        "fcmToken": {
          "type": "string",
          "description": "The Firebase Cloud Messaging token for push notifications."
        },
        "lastStreakActivityAt": {
          "type": "string",
          "description": "Timestamp of the user's last activity that counts towards a streak (reading or reflection).",
          "format": "date-time"
        },
        "lastFreezeRefill": {
          "type": "string",
          "description": "Timestamp of the last time freezes were refilled (Mondays).",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "batchYear",
        "guidingSaint",
        "points",
        "level",
        "streak",
        "status",
        "role"
      ]
    },
    "Book": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Book",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Book entity."
        },
        "title": {
          "type": "string",
          "description": "The title of the book."
        },
        "description": {
          "type": "string",
          "description": "A brief summary or description of the book."
        },
        "totalPages": {
          "type": "number",
          "description": "The total number of pages in the book.",
          "format": "int32"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "current", "finished", "archived"]
        },
        "currentReadingPlanDueDate": {
          "type": "string",
          "description": "The due date for completing this book within the current bookclub reading plan. (Optional)",
          "format": "date-time"
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "title",
        "description",
        "totalPages"
      ]
    },
    "Challenge": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Challenge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "pointsReward": { "type": "number" },
        "completionCriteria": { "type": "string" },
        "type": { "type": "string" },
        "isActive": { "type": "boolean" },
        "totalCompletions": {
          "type": "number",
          "description": "The total number of times this challenge has been completed across all users."
        }
      },
      "required": ["id", "title", "pointsReward", "type", "isActive"]
    },
    "UserChallenge": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserChallenge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "challengeId": { "type": "string" },
        "status": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" },
        "pointsEarned": { "type": "number" },
        "submissionText": { "type": "string", "description": "Text submitted by the user to complete the challenge." }
      },
      "required": ["id", "userId", "challengeId", "status"]
    },
    "Discussion": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Discussion",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "topic": { "type": "string" },
        "scheduledDateTime": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "topic", "scheduledDateTime", "isActive"]
    },
    "Notification": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "message": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "message", "isRead", "createdAt", "expiresAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "User profiles."
        }
      },
      {
        "path": "/users/{userId}/notifications/{notificationId}",
        "definition": {
          "entityName": "Notification",
          "schema": { "$ref": "#/backend/entities/Notification" },
          "description": "User-specific notifications."
        }
      },
      {
        "path": "/users/{userId}/userChallenges/{userChallengeId}",
        "definition": {
          "entityName": "UserChallenge",
          "schema": {
            "$ref": "#/backend/entities/UserChallenge"
          },
          "description": "Records of challenges a user has completed."
        }
      },
      {
        "path": "/challenges/{challengeId}",
        "definition": {
          "entityName": "Challenge",
          "schema": { "$ref": "#/backend/entities/Challenge" },
          "description": "Global challenges."
        }
      },
      {
        "path": "/discussions/{discussionId}",
        "definition": {
          "entityName": "Discussion",
          "schema": { "$ref": "#/backend/entities/Discussion" },
          "description": "Scheduled discussions."
        }
      },
      {
        "path": "/books/{bookId}",
        "definition": {
          "entityName": "Book",
          "schema": { "$ref": "#/backend/entities/Book" },
          "description": "Global library of books."
        }
      }
    ]
  }
}
