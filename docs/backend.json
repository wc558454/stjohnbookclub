
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a member of the St. John Chrysostom Bookclub, including their personal details, progress metrics, and administrative attributes.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "name": {
          "type": "string",
          "description": "The full name of the user."
        },
        "email": {
          "type": "string",
          "description": "The user's email address, used for contact and display purposes. (Not for authentication credentials)",
          "format": "email"
        },
        "profilePictureUrl": {
          "type": "string",
          "description": "URL to the user's uploaded profile picture.",
          "format": "uri"
        },
        "batchYear": {
          "type": "string",
          "description": "The year or batch identifier when the user joined the bookclub."
        },
        "readingLevel": {
          "type": "string",
          "description": "A descriptive level indicating the user's reading proficiency or engagement (e.g., 'Beginner', 'Intermediate', 'Advanced')."
        },
        "points": {
          "type": "number",
          "description": "The total cumulative points earned by the user.",
          "format": "int32"
        },
        "level": {
          "type": "number",
          "description": "The current achievement level of the user based on points or engagement.",
          "format": "int32"
        },
        "streak": {
          "type": "number",
          "description": "The current consecutive daily reading streak of the user.",
          "format": "int32"
        },
        "status": {
          "type": "string",
          "description": "The active status of the user (e.g., 'Active', 'Inactive')."
        },
        "role": {
          "type": "string",
          "description": "The role of the user within the bookclub (e.g., 'member', 'admin')."
        },
        "spiritualGoal": {
          "type": "string",
          "description": "A short, personal spiritual goal set by the user during registration.",
          "maxLength": 500
        },
        "monthlyPoints": {
          "type": "number",
          "description": "The total points earned by the user in the current month.",
          "format": "int32"
        },
        "currentMonth": {
          "type": "string",
          "description": "The current month for which monthly points are being tracked, in YYYY-MM format."
        },
        "personalBestPages": {
          "type": "number",
          "description": "The highest number of pages read by the user in a single day.",
          "format": "int32"
        },
        "currentPagesRead": {
          "type": "number",
          "description": "Pages read in the current active book."
        },
        "freezeCount": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "batchYear",
        "readingLevel",
        "points",
        "level",
        "streak",
        "status",
        "role"
      ]
    },
    "Book": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Book",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Book entity."
        },
        "title": {
          "type": "string",
          "description": "The title of the book."
        },
        "description": {
          "type": "string",
          "description": "A brief summary or description of the book."
        },
        "totalPages": {
          "type": "number",
          "description": "The total number of pages in the book.",
          "format": "int32"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "current", "finished", "archived"]
        },
        "currentReadingPlanDueDate": {
          "type": "string",
          "description": "The due date for completing this book within the current bookclub reading plan. (Optional)",
          "format": "date-time"
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "title",
        "description",
        "totalPages"
      ]
    },
    "ReadingProgress": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ReadingProgress",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Equal to the bookId." },
        "bookId": { "type": "string" },
        "pagesRead": { "type": "number" },
        "isFinished": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "bookId", "pagesRead"]
    },
    "Challenge": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Challenge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "pointsReward": { "type": "number" },
        "completionCriteria": { "type": "string" },
        "type": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "title", "pointsReward", "type", "isActive"]
    },
    "UserChallenge": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserChallenge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "challengeId": { "type": "string" },
        "status": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" },
        "pointsEarned": { "type": "number" },
        "submissionText": { "type": "string", "description": "Text submitted by the user to complete the challenge." }
      },
      "required": ["id", "userId", "challengeId", "status"]
    },
    "Discussion": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Discussion",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "topic": { "type": "string" },
        "scheduledDateTime": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "topic", "scheduledDateTime", "isActive"]
    },
    "Notification": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "message": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "message", "isRead", "createdAt", "expiresAt"]
    },
    "ForumPost": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ForumPost",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "content": { "type": "string" },
        "likes": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorId", "authorName", "content", "createdAt"]
    },
    "ForumComment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ForumComment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "postId", "authorId", "authorName", "content", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "User profiles."
        }
      },
      {
        "path": "/users/{userId}/notifications/{notificationId}",
        "definition": {
          "entityName": "Notification",
          "schema": { "$ref": "#/backend/entities/Notification" },
          "description": "User-specific notifications."
        }
      },
      {
        "path": "/users/{userId}/userChallenges/{userChallengeId}",
        "definition": {
          "entityName": "UserChallenge",
          "schema": {
            "$ref": "#/backend/entities/UserChallenge"
          },
          "description": "Records of challenges a user has completed."
        }
      },
      {
        "path": "/users/{userId}/readingProgress/{bookId}",
        "definition": {
          "entityName": "ReadingProgress",
          "schema": { "$ref": "#/backend/entities/ReadingProgress" },
          "description": "Per-book reading progress for a user."
        }
      },
      {
        "path": "/forumPosts/{postId}",
        "definition": {
          "entityName": "ForumPost",
          "schema": { "$ref": "#/backend/entities/ForumPost" },
          "description": "Global collection for forum posts."
        }
      },
      {
        "path": "/forumPosts/{postId}/comments/{commentId}",
        "definition": {
          "entityName": "ForumComment",
          "schema": { "$ref": "#/backend/entities/ForumComment" },
          "description": "Comments on a forum post."
        }
      },
      {
        "path": "/challenges/{challengeId}",
        "definition": {
          "entityName": "Challenge",
          "schema": { "$ref": "#/backend/entities/Challenge" },
          "description": "Global challenges."
        }
      },
      {
        "path": "/discussions/{discussionId}",
        "definition": {
          "entityName": "Discussion",
          "schema": { "$ref": "#/backend/entities/Discussion" },
          "description": "Scheduled discussions."
        }
      },
      {
        "path": "/books/{bookId}",
        "definition": {
          "entityName": "Book",
          "schema": { "$ref": "#/backend/entities/Book" },
          "description": "Global library of books."
        }
      }
    ]
  }
}
